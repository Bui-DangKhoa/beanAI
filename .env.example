# ==========================================
# Cấu hình Môi trường BeanAI (Environment Variables Template)
# Sao chép tệp này thành .env trước khi triển khai
# ==========================================

# Cổng khởi chạy ứng dụng Spring Boot
SERVER_PORT=8080

# Cấu hình Kết nối MySQL Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/beanai_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Cấu hình Hibernate JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Cấu hình Thymeleaf (true cho production, false khi dev giao diện)
SPRING_THYMELEAF_CACHE=true

# Cấu hình AI Service & Mô hình best.pt
# Để trống BEANAI_PYTHON_PATH để hệ thống tự động nhận diện python trên máy
BEANAI_PYTHON_PATH=
BEANAI_MODEL_PATH=src/main/resources/static/best.pt
BEANAI_SCRIPT_PATH=ai-service/predict.py
BEANAI_UPLOAD_DIR=uploads
